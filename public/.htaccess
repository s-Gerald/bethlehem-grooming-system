<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule (^|/)(?:auth\.json|Homestead\.(?:json|yaml))~?$ - [F,L,NC]
    RewriteRule \.(?:sql|sqlite3?|db|log|ini|bak|backup|old|orig|env)(?:$|/) - [F,L,NC]
    RewriteRule ^(?!index\.php$).*\.php(?:/|$) - [F,L,NC]
    # Older clinical uploads may still exist under the public storage symlink.
    # Staff download controllers retain scoped access to these legacy files.
    RewriteRule ^storage/(?:clinic|payment-proofs)(?:/|$) - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Browser documents must reach Laravel even when their old HTML file exists.
    # Fragments and assets keep Apache's existing-file fast path.
    RewriteRule ^(?:index\.html|pages/client/(?:sign-in|signup|forgot-password|verify-email|set-up-password|confirm-email-recovery|dashboard|my-pets|pet-details|grooming-history|notifications|settings|pre-register|grooming-pre-registration|booking-pet-details|clinic-visit-reason|clinic-visit-summary|clinic-visit-confirmed|clinic-visit-date)\.html|pages/admin/(?:dashboard|clients|appointments|clinic|archive|transactions|reports|services|settings|notifications|activity-log|availability|walk-in-booking|walk-in-pet-details|walk-in-grooming-services|walk-in-booking-review|walk-in-consent|walk-in-booking-confirmed|walk-in-clinic-confirmed)\.html|pages/admin/inventory/(?:inventory|pos)\.html|pages/legal/(?:terms-and-conditions|privacy-policy)\.html)$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
