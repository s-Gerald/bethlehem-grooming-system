<IfModule mod_headers.c>
    <Files "sign-in.html">
        Header always set Cache-Control "no-store, private, max-age=0, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^pages/admin/(activity-log|availability)\.html$ public/index.php [L]
    RewriteRule ^resources/views/admin/(activity-log|availability)\.html$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    RewriteRule ^ public/index.php [L]
</IfModule>
