<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^pages/admin/activity-log\.html$ public/index.php [L]
    RewriteRule ^resources/views/admin/activity-log\.html$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    RewriteRule ^ public/index.php [L]
</IfModule>
