<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-capacity-mysql.php"
         cacheResult="false" failOnSkipped="true" failOnIncomplete="true"
         failOnRisky="true" failOnWarning="true">
    <testsuites>
        <testsuite name="Isolated MySQL capacity">
            <file>tests/Feature/GroomingAdministrationAuthorizationTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_SOCKET" value="" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="AUTH_MAIL_DELIVERY" value="queued" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
    </php>
</phpunit>
