APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
LOGIN_CONFIRMATION_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15
PRIVILEGED_CREDENTIAL_CHANGE_CODE_TTL_MINUTES=10
PENDING_REGISTRATION_RETENTION_HOURS=48

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false
PAYMONGO_PAYMENT_METHODS=qrph,gcash,paymaya,card
PAYMONGO_RETURN_URL=http://127.0.0.1:8000/pages/admin/appointments.html

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" is for local inspection only and never delivers to an inbox.
# Production uses Brevo through Laravel SMTP; see docs/hostinger-email-auth.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=30
# Use immediate only with the database queue and a shared cache on cron-only hosting.
AUTH_MAIL_DELIVERY=queued
AUTH_MAIL_QUEUE=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Bethlehem Animal Clinic"

# Privileged seed users are created only when strong credentials are supplied.
ADMIN_SEED_USERNAME=Admin
ADMIN_SEED_EMAIL=bethlehem.admin.test@gmail.com
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
STAFF_SEED_USERNAME=groomingstaff
STAFF_SEED_EMAIL=bethlehem.staff.test@gmail.com
STAFF_SEED_PHONE=
STAFF_SEED_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
