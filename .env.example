APP_NAME=Laravel
IPROGSMS_API_TOKEN=
GROOMING_COMPLETION_SMS_ENABLED=false
SMS_USER_DAILY_LIMIT=20
SMS_PHONE_DAILY_LIMIT=20
SMS_GLOBAL_DAILY_LIMIT=500
SMS_VERIFICATION_AVAILABLE=false
SMS_VERIFICATION_ENFORCED=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
# Optional comma-separated trusted frontend origins; defaults to APP_URL.
# Include an exact origin only when serving the frontend on another origin.
# FRONTEND_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5500
LOGIN_CONFIRMATION_TTL_MINUTES=10
REGISTRATION_MAGIC_LINK_MINUTES=30
AUTH_EMAIL_COOLDOWN_SECONDS=60
AUTH_EMAIL_QUARTER_HOUR_LIMIT=3
AUTH_EMAIL_HOURLY_LIMIT=6
AUTH_EMAIL_DAILY_LIMIT=12
AUTH_EMAIL_IP_HOURLY_LIMIT=30
AUTH_EMAIL_IP_DAILY_LIMIT=100
AUTH_EMAIL_PROVIDER_DAILY_LIMIT=100
AUTH_EMAIL_LOGIN_LIMIT=3
AUTH_EMAIL_LOGIN_SOURCE_LIMIT=15
AUTH_EMAIL_REGISTRATION_LIMIT=3
AUTH_EMAIL_RECOVERY_LIMIT=3
AUTH_EMAIL_PRIVILEGED_LIMIT=3
AUTH_OTP_ATTEMPTS=5
AUTH_OTP_SOURCE_ATTEMPTS=5
AUTH_OTP_SOURCE_RESET_SECONDS=1800
AUTH_OTP_ACCOUNT_ATTEMPTS=20
AUTH_OTP_IP_ATTEMPTS=25
AUTH_OTP_ATTEMPT_WINDOW=900
AUTH_LOGIN_OUTSTANDING_CHALLENGES=10
AUTH_SECURITY_FAILURE_THRESHOLD=3
AUTH_SECURITY_SOURCE_THRESHOLD=3
AUTH_SECURITY_SOURCE_WINDOW=1800
AUTH_SECURITY_INCOMPLETE_SECONDS=120
AUTH_SECURITY_RETENTION_DAYS=90
# Exact proxy IP/CIDR allowlist only; leave empty for direct localhost traffic.
AUTH_TRUSTED_PROXIES=
# Optional fixed transition deadline for older links; leave unset to retire them.
# REGISTRATION_LEGACY_LINKS_UNTIL=2026-10-29T00:00:00+08:00
PASSWORD_RESET_TTL_MINUTES=15
PRIVILEGED_CREDENTIAL_CHANGE_CODE_TTL_MINUTES=10
# Pending signup retention is fixed at one hour in config/app.php.


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" is for local inspection only and never delivers to an inbox.
# Production uses Brevo through Laravel SMTP; see docs/hostinger-email-auth.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=30
# Use immediate only with the database queue and a shared cache on cron-only hosting.
AUTH_MAIL_DELIVERY=queued
AUTH_MAIL_QUEUE=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Bethlehem Animal Clinic"

# Privileged seed users are created only when strong credentials are supplied.
ADMIN_SEED_USERNAME=Admin
ADMIN_SEED_EMAIL=bethlehem.admin.test@gmail.com
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
STAFF_SEED_USERNAME=groomingstaff
STAFF_SEED_EMAIL=bethlehem.staff.test@gmail.com
STAFF_SEED_PHONE=
STAFF_SEED_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false
PAYMONGO_PAYMENT_METHODS=qrph
PAYMONGO_RETURN_URL=http://127.0.0.1:8000/pages/admin/appointments.html
